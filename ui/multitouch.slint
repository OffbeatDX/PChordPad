export global MultiTouch {
    in property <bool> a0;
    in property <length> x0;
    in property <length> y0;
    in property <bool> a1;
    in property <length> x1;
    in property <length> y1;
    in property <bool> a2;
    in property <length> x2;
    in property <length> y2;
    in property <bool> a3;
    in property <length> x3;
    in property <length> y3;
    in property <bool> a4;
    in property <length> x4;
    in property <length> y4;
    in property <bool> a5;
    in property <length> x5;
    in property <length> y5;
    in property <bool> a6;
    in property <length> x6;
    in property <length> y6;
    in property <bool> a7;
    in property <length> x7;
    in property <length> y7;
    in property <bool> a8;
    in property <length> x8;
    in property <length> y8;

    pure function hit(
        active: bool, px: length, py: length,
        x: length, y: length, w: length, h: length,
    ) -> bool {
        active && px >= x && px < x + w && py >= y && py < y + h;
    }

    public pure function inside(x: length, y: length, w: length, h: length) -> bool {
        hit(a0, x0, y0, x, y, w, h) || hit(a1, x1, y1, x, y, w, h) || hit(a2, x2, y2, x, y, w, h)
            || hit(a3, x3, y3, x, y, w, h) || hit(a4, x4, y4, x, y, w, h)
            || hit(a5, x5, y5, x, y, w, h) || hit(a6, x6, y6, x, y, w, h)
            || hit(a7, x7, y7, x, y, w, h) || hit(a8, x8, y8, x, y, w, h);
    }

    public pure function local-x(x: length, y: length, w: length, h: length) -> length {
        hit(a0, x0, y0, x, y, w, h) ? x0 - x
            : hit(a1, x1, y1, x, y, w, h) ? x1 - x
            : hit(a2, x2, y2, x, y, w, h) ? x2 - x
            : hit(a3, x3, y3, x, y, w, h) ? x3 - x
            : hit(a4, x4, y4, x, y, w, h) ? x4 - x
            : hit(a5, x5, y5, x, y, w, h) ? x5 - x
            : hit(a6, x6, y6, x, y, w, h) ? x6 - x
            : hit(a7, x7, y7, x, y, w, h) ? x7 - x
            : hit(a8, x8, y8, x, y, w, h) ? x8 - x
            : -1px;
    }
    public pure function local-y(x: length, y: length, w: length, h: length) -> length {
        hit(a0, x0, y0, x, y, w, h) ? y0 - y
            : hit(a1, x1, y1, x, y, w, h) ? y1 - y
            : hit(a2, x2, y2, x, y, w, h) ? y2 - y
            : hit(a3, x3, y3, x, y, w, h) ? y3 - y
            : hit(a4, x4, y4, x, y, w, h) ? y4 - y
            : hit(a5, x5, y5, x, y, w, h) ? y5 - y
            : hit(a6, x6, y6, x, y, w, h) ? y6 - y
            : hit(a7, x7, y7, x, y, w, h) ? y7 - y
            : hit(a8, x8, y8, x, y, w, h) ? y8 - y
            : -1px;
    }
}
