import { Theme } from "theme.slint";

component NoteKey inherits Rectangle {
    in property <int> index;
    in property <bool> held;
    in property <bool> light: false;
    in property <brush> lit: Theme.accent-a;
    in property <length> radius: root.light ? Theme.radius-sm : Theme.radius-lg;
    property <color> glow: root.light ? Theme.key-lit : Theme.accent-a;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        drop-shadow-blur: 36px;
        drop-shadow-color: root.glow.with-alpha(0.35);
        opacity: root.held ? 1.0 : 0.0;
        animate opacity {
            duration: root.held ? 0ms : 220ms;
            easing: ease-out;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: root.light
            ? @linear-gradient(180deg, #f4f0e8, #ddd6ca)
            : Theme.surface2;
        border-width: 1px;
        border-color: root.light ? Theme.key-idle-edge : Theme.border;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: root.light
            ? @linear-gradient(180deg,
                Theme.key-lit.mix(#ffffff, 0.4).with-alpha(0.65),
                Theme.key-lit-core.with-alpha(0.9),
                Theme.key-lit.with-alpha(0.55))
            : root.lit;
        opacity: root.held ? 1.0 : 0.0;
        animate opacity {
            duration: root.held ? 0ms : 220ms;
            easing: ease-out;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(90deg,
            #ffffff.with-alpha(0.0),
            #ffffff.with-alpha(0.1),
            #ffffff.with-alpha(0.18),
            #ffffff.with-alpha(0.1),
            #ffffff.with-alpha(0.0));
        opacity: root.held ? 1.0 : 0.0;
        animate opacity {
            duration: root.held ? 0ms : 200ms;
            easing: ease-out;
        }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: root.radius;
        background: @linear-gradient(180deg,
            #ffffff.with-alpha(0.12),
            transparent,
            #000000.with-alpha(0.1));
        opacity: root.held ? 1.0 : 0.0;
        animate opacity {
            duration: root.held ? 0ms : 200ms;
            easing: ease-out;
        }
    }

    Rectangle {
        width: 100%;
        height: parent.height * 0.28;
        border-radius: root.radius;
        background: @linear-gradient(180deg, #ffffff.with-alpha(0.14), transparent);
        opacity: root.light ? (root.held ? 0.55 : 0.3) : (root.held ? 0.2 : 0.0);
    }

    if !root.light : Text {
        x: 0;
        width: 100%;
        y: parent.height - self.height - 18px;
        horizontal-alignment: center;
        text: root.index;
        font-size: clamp(root.width * 0.22, 14px, 40px);
        font-weight: 800;
        color: root.held ? Theme.text-on-accent : Theme.text3;
    }
}

component FaderChevron inherits Rectangle {
    in property <color> accent;
    in property <bool> point-left: true;
    in property <bool> bright: false;
    clip: false;
    property <float> a: root.bright ? 1.0 : 0.5;
    property <color> rim: root.accent.mix(#000000, 0.35).with-alpha(root.a * 0.85);
    property <color> body: root.accent.with-alpha(root.a);
    property <color> core: root.accent.mix(#ffffff, root.bright ? 0.45 : 0.22).with-alpha(root.a);
    property <length> stroke: clamp(min(root.width, root.height) * 0.15, 8px, 20px);

    Path {
        width: 100%;
        height: 100%;
        clip: false;
        stroke: root.accent.with-alpha(root.a * 0.28);
        stroke-width: root.stroke * 1.55;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;

        MoveTo { x: root.point-left ? 54 : 46; y: 18; }
        LineTo { x: root.point-left ? 26 : 74; y: 50; }
        LineTo { x: root.point-left ? 54 : 46; y: 82; }

        MoveTo { x: root.point-left ? 80 : 20; y: 18; }
        LineTo { x: root.point-left ? 52 : 48; y: 50; }
        LineTo { x: root.point-left ? 80 : 20; y: 82; }
    }

    Path {
        width: 100%;
        height: 100%;
        clip: false;
        stroke: root.rim;
        stroke-width: root.stroke;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;

        MoveTo { x: root.point-left ? 54 : 46; y: 18; }
        LineTo { x: root.point-left ? 26 : 74; y: 50; }
        LineTo { x: root.point-left ? 54 : 46; y: 82; }

        MoveTo { x: root.point-left ? 80 : 20; y: 18; }
        LineTo { x: root.point-left ? 52 : 48; y: 50; }
        LineTo { x: root.point-left ? 80 : 20; y: 82; }
    }

    Path {
        width: 100%;
        height: 100%;
        clip: false;
        stroke: root.body;
        stroke-width: root.stroke * 0.62;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;

        MoveTo { x: root.point-left ? 54 : 46; y: 18; }
        LineTo { x: root.point-left ? 26 : 74; y: 50; }
        LineTo { x: root.point-left ? 54 : 46; y: 82; }

        MoveTo { x: root.point-left ? 80 : 20; y: 18; }
        LineTo { x: root.point-left ? 52 : 48; y: 50; }
        LineTo { x: root.point-left ? 80 : 20; y: 82; }
    }

    Path {
        width: 100%;
        height: 100%;
        clip: false;
        stroke: root.core;
        stroke-width: root.stroke * 0.28;
        stroke-line-cap: round;
        stroke-line-join: round;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 100;
        viewbox-height: 100;

        MoveTo { x: root.point-left ? 54 : 46; y: 18; }
        LineTo { x: root.point-left ? 26 : 74; y: 50; }
        LineTo { x: root.point-left ? 54 : 46; y: 82; }

        MoveTo { x: root.point-left ? 80 : 20; y: 18; }
        LineTo { x: root.point-left ? 52 : 48; y: 50; }
        LineTo { x: root.point-left ? 80 : 20; y: 82; }
    }
}

component FaderView inherits Rectangle {
    in property <string> label;
    in property <color> accent: Theme.fader-l;
    in property <length> track-w: root.width * 0.55;
    in property <float> value: 0.0;
    in property <bool> grabbed: false;
    clip: false;
    background: transparent;

    property <length> head-h: 34px;
    property <length> track-y: root.head-h;
    property <length> track-h: max(1px, root.height - root.head-h);
    property <length> handle-w: clamp(root.track-w * 0.07, 16px, 26px);
    property <length> handle-h: clamp(root.track-h * 0.58, 44px, 120px);
    property <length> bar-h: clamp(root.track-h * 0.16, 10px, 24px);
    property <length> bar-y: root.track-y + (root.track-h - root.bar-h) / 2;

    property <length> min-gutter: 36px;
    property <length> track-vis-w: min(root.track-w, max(1px, root.width - 2 * root.min-gutter));
    property <length> track-x: (root.width - root.track-vis-w) / 2;
    property <length> gutter-l-w: root.track-x;
    property <length> gutter-r-w: root.width - root.track-x - root.track-vis-w;
    property <length> center-x: root.track-x + root.track-vis-w / 2;
    property <length> half: max(1px, (root.track-vis-w - root.handle-w) / 2);

    out property <length> zone-y: root.track-y;
    out property <length> zone-h: root.track-h;
    out property <length> zone-center-x: root.center-x;
    out property <length> zone-half: root.half;

    Text {
        x: root.track-x;
        width: root.track-vis-w;
        y: 6px;
        horizontal-alignment: center;
        text: root.label;
        font-size: 15px;
        font-weight: 800;
        letter-spacing: 3px;
        color: root.grabbed ? root.accent : Theme.text2;
    }

    FaderChevron {
        x: 0;
        y: root.track-y;
        width: root.gutter-l-w;
        height: root.track-h;
        accent: root.accent;
        point-left: true;
        bright: root.value < -0.12 || root.grabbed;
    }

    FaderChevron {
        x: root.track-x + root.track-vis-w;
        y: root.track-y;
        width: root.gutter-r-w;
        height: root.track-h;
        accent: root.accent;
        point-left: false;
        bright: root.value > 0.12 || root.grabbed;
    }

    Rectangle {
        x: root.track-x;
        y: root.track-y + 4px;
        width: root.track-vis-w;
        height: root.track-h - 8px;
        border-radius: 4px;
        background: #08080c;
    }

    Rectangle {
        x: root.track-x + root.handle-w / 2;
        y: root.bar-y;
        width: root.track-vis-w - root.handle-w;
        height: root.bar-h;
        border-radius: root.bar-h / 2;
        background: #141418;
        border-width: 1px;
        border-color: #3a3a42;
    }

    for i in 11 : Rectangle {
        x: root.track-x + root.handle-w / 2
            + (root.track-vis-w - root.handle-w) * i / 10.0 - 0.5px;
        y: root.bar-y - 6px;
        width: 1px;
        height: root.bar-h + 12px;
        background: Theme.text3;
        opacity: i == 5 ? 0.65 : 0.2;
    }

    Rectangle {
        x: root.center-x + root.value * root.half - root.handle-w / 2;
        y: root.bar-y + root.bar-h / 2 - root.handle-h / 2;
        width: root.handle-w;
        height: root.handle-h;
        border-radius: 4px;
        background: root.accent;
        border-width: 1px;
        border-color: #ffffff55;
        drop-shadow-blur: root.grabbed ? 14px : 6px;
        drop-shadow-color: root.accent.with-alpha(0.45);
    }
}

export component FitSlider inherits Rectangle {
    in-out property <float> value: 1.0;
    in property <length> handle: 22px;
    in property <length> track: 8px;
    property <length> pad: root.handle / 2 + 2px;
    property <length> travel: max(1px, self.width - 2 * root.pad);
    min-height: root.handle + 12px;

    function set-from(mx: length) {
        root.value = clamp((mx - root.pad) / root.travel, 0.0, 1.0);
    }

    Rectangle {
        x: root.pad;
        width: root.travel;
        height: root.track;
        border-radius: root.track / 2;
        background: Theme.surface2;
        Rectangle {
            x: 0;
            width: parent.width * root.value;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent-grad;
        }
    }
    Rectangle {
        x: root.pad + root.travel * root.value - self.width / 2;
        width: root.handle;
        height: root.handle;
        border-radius: self.width / 2;
        background: sa.pressed ? Theme.accent-a : Theme.text1;
        border-width: 2px;
        border-color: sa.pressed ? Theme.text1 : transparent;
        drop-shadow-blur: sa.pressed ? 10px : 5px;
        drop-shadow-color: #000000aa;
    }
    sa := TouchArea {
        moved => { root.set-from(self.mouse-x); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.set-from(self.mouse-x); }
        }
    }
}

export component PChordPanel inherits Rectangle {
    in property <[bool]> key-held;
    in property <bool> light-keys: false;

    in property <float> fader-l-value: 0.0;
    in property <float> fader-r-value: 0.0;
    in property <bool> grabbed-l: false;
    in property <bool> grabbed-r: false;

    in property <float> key-height: 0.66;
    in property <float> fader-pos: 0.0;

    in property <float> min-fit: 0.4;
    in property <float> fit: 1.0;
    property <length> content-w: root.width * (root.min-fit + (1.0 - root.min-fit) * root.fit);
    property <length> content-x: (root.width - root.content-w) / 2;

    out property <float> key-geom-x: (root.content-x + root.margin) / 1px;
    out property <float> key-geom-y: root.row-y / 1px;
    out property <float> key-geom-w: (root.content-w - 2 * root.margin) / 1px;
    out property <float> key-geom-h: root.row-h / 1px;
    out property <float> key-geom-key-w: root.key-w / 1px;
    out property <float> key-geom-gap: root.key-gap / 1px;

    out property <float> fader-l-zone-x: fl.x / 1px;
    out property <float> fader-l-zone-y: (fl.y + fl.zone-y) / 1px;
    out property <float> fader-l-zone-w: fl.width / 1px;
    out property <float> fader-l-zone-h: fl.zone-h / 1px;
    out property <float> fader-l-center-x: (fl.x + fl.zone-center-x) / 1px;
    out property <float> fader-l-half: fl.zone-half / 1px;
    out property <float> fader-r-zone-x: fr.x / 1px;
    out property <float> fader-r-zone-y: (fr.y + fr.zone-y) / 1px;
    out property <float> fader-r-zone-w: fr.width / 1px;
    out property <float> fader-r-zone-h: fr.zone-h / 1px;
    out property <float> fader-r-center-x: (fr.x + fr.zone-center-x) / 1px;
    out property <float> fader-r-half: fr.zone-half / 1px;

    property <length> margin: max(12px, root.content-w * 0.01);
    property <length> gap: max(8px, root.content-w * 0.006);
    property <length> body-y: root.margin;
    property <length> body-h: max(1px, root.height - 2 * root.margin);

    property <length> key-gap: max(2px, root.content-w * 0.002);
    property <length> key-w: (root.content-w - 2 * root.margin - 11 * root.key-gap) / 12;

    property <length> row-h: clamp(root.key-height, 0.2, 0.9) * root.body-h;
    property <length> row-y: root.body-y + root.body-h - root.row-h;
    property <length> free-h: max(0px, root.row-y - root.body-y);

    property <length> fader-h: min(root.body-h * 0.33, max(1px, root.free-h - root.gap));
    property <length> fader-slack: max(0px, root.free-h - root.gap - root.fader-h);
    property <length> fader-y: root.body-y + clamp(root.fader-pos, 0.0, 1.0) * root.fader-slack;
    property <length> fader-track-w: 4 * root.key-w + 3 * root.key-gap;
    property <length> fader-zone-gap: root.gap;
    property <length> fader-zone-w: (root.content-w - 2 * root.margin - root.fader-zone-gap) / 2;
    property <length> fader-l-x: root.content-x + root.margin;
    property <length> fader-r-x: root.fader-l-x + root.fader-zone-w + root.fader-zone-gap;

    public pure function key-x(i: int) -> length {
        root.content-x + root.margin + i * (root.key-w + root.key-gap);
    }

    background: Theme.bg;

    Rectangle {
        x: root.content-x;
        y: root.fader-y - 4px;
        width: root.content-w;
        height: root.fader-h + 8px;
        background: #050506;
    }

    fl := FaderView {
        x: root.fader-l-x;
        y: root.fader-y;
        width: root.fader-zone-w;
        height: root.fader-h;
        track-w: root.fader-track-w;
        label: "FADER-L";
        accent: Theme.fader-l;
        value: root.fader-l-value;
        grabbed: root.grabbed-l;
    }
    fr := FaderView {
        x: root.fader-r-x;
        y: root.fader-y;
        width: root.fader-zone-w;
        height: root.fader-h;
        track-w: root.fader-track-w;
        label: "FADER-R";
        accent: Theme.fader-r;
        value: root.fader-r-value;
        grabbed: root.grabbed-r;
    }

    if root.light-keys : Rectangle {
        x: root.content-x + root.margin - 2px;
        y: root.row-y - 2px;
        width: root.content-w - 2 * root.margin + 4px;
        height: root.row-h + 4px;
        border-radius: 2px;
        background: #d8d4cc;
        border-width: 1px;
        border-color: #a8a49c;
    }

    if !root.light-keys : Rectangle {
        x: root.content-x;
        y: root.row-y - root.gap;
        width: root.content-w;
        height: root.row-h + 2 * root.gap;
        background: @linear-gradient(180deg,
            Theme.accent-b.with-alpha(0.0),
            Theme.accent-b.with-alpha(0.10));
    }

    for i in 12 : NoteKey {
        x: root.key-x(i);
        y: root.row-y;
        width: root.key-w;
        height: root.row-h;
        index: i + 1;
        held: i < root.key-held.length ? root.key-held[i] : false;
        light: root.light-keys;
        lit: Theme.accent-a.mix(Theme.accent-b, 1.0 - i / 11.0);
    }
}
